import java.util.*;

public class LambdaExample {

    public static void main(String[] args) {

        List<String> names = new ArrayList<>();

        names.add("Ravi");
        names.add("Ankit");
        names.add("Suhani");
        names.add("Bhavana");

        Collections.sort(names, (a, b) -> a.compareTo(b));

        System.out.println(names);
    }
}