--------------------------------------------------------
-- Question 3
-- Print reminders for loans due within next 30 days
--------------------------------------------------------

DECLARE

    CURSOR c_loans IS

        SELECT CustomerID,
               LoanID,
               EndDate
        FROM Loans
        WHERE EndDate BETWEEN SYSDATE
                          AND SYSDATE + 30;

BEGIN

    FOR rec IN c_loans LOOP

        DBMS_OUTPUT.PUT_LINE(
            'Reminder: Customer '
            || rec.CustomerID
            || ' Loan '
            || rec.LoanID
            || ' is due on '
            || TO_CHAR(rec.EndDate,'DD-MON-YYYY')
        );

    END LOOP;

END;
/





