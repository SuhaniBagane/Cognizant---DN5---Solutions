--------------------------------------------------------
-- Question 1
-- Apply 1% discount on loan interest for customers
-- above 60 years of age
--------------------------------------------------------

DECLARE
    CURSOR c_customers IS
        SELECT c.CustomerID,
               c.DOB,
               l.LoanID,
               l.InterestRate
        FROM Customers c
        JOIN Loans l
        ON c.CustomerID = l.CustomerID;
BEGIN

    FOR rec IN c_customers LOOP

        IF TRUNC(MONTHS_BETWEEN(SYSDATE, rec.DOB)/12) > 60 THEN

            UPDATE Loans
            SET InterestRate = InterestRate - 1
            WHERE LoanID = rec.LoanID;

        END IF;

    END LOOP;

    COMMIT;

    DBMS_OUTPUT.PUT_LINE('Loan interest updated successfully.');

END;
/

